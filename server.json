{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.aidev-iprokszin/ipcam-mcp",
  "title": "IP cameras (ONVIF/RTSP)",
  "description": "MCP server for local IP cameras (ONVIF/RTSP): snapshots, recordings, pan/tilt, presets",
  "repository": {
    "url": "https://github.com/aidev-iprokszin/ipcam-mcp",
    "source": "github"
  },
  "version": "0.4.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "ipcam-mcp",
      "version": "0.4.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "IPCAM_MCP_CONFIG",
          "description": "Path to cameras.toml (default: ~/.config/ipcam-mcp/cameras.toml)",
          "isRequired": false,
          "format": "filepath"
        }
      ]
    }
  ]
}
